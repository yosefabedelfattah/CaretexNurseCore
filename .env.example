APP_ENV=development
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
LOG_LEVEL=info

ALLOWED_ORIGINS=http://localhost:4200

DB_HOST=localhost
DB_PORT=5432
DB_NAME=caretexnurse
DB_USER=dev
DB_PASSWORD=dev
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10

# Generate strong secrets in production: `openssl rand -hex 32`
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Caretx external API integration
# Auth: Authorization: Bearer <KeyID>:<Secret>
# No Firebase, no token refresh — tenant derived server-side from credential.
CARETX_BASE_URL=https://caretex.me:8080
CARETX_KEY_ID=ck_live_XXXX
CARETX_SECRET=sk_XXXX
CARETX_TIMEOUT=15s
# Auto-sync interval (0 = disabled). Pulls residents & departments from Caretex.
CARETX_SYNC_INTERVAL=5m

RATE_LIMIT_RPS=20
